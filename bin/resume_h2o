#!/usr/bin/env python3
import sqlite3
import os
import sys
from datetime import datetime

DB_PATH = os.path.expanduser("~/.matrix_ide/database/h2o_pedagogy.db")
MAX_ENTRIES = 50

def resume():
    if not os.path.exists(DB_PATH):
        print("No H2OIDE history found.")
        return

    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # Retrieve recent conversations
    c.execute("SELECT role, content, timestamp FROM layer2_conversations ORDER BY timestamp DESC LIMIT ?", (MAX_ENTRIES,))
    rows = c.fetchall()[::-1] # Reverse to get chronological order
    
    print(f"--- RESUMING H2OIDE CONTEXT ({len(rows)} entries) ---")
    for role, content, timestamp in rows:
        # Simple truncation for display
        truncated_content = (content[:200] + '...') if len(content) > 200 else content
        print(f"[{timestamp}] {role.upper()}: {truncated_content}")
    
    # Prune old logs (optional: keep DB lean)
    c.execute("DELETE FROM layer2_conversations WHERE rowid NOT IN (SELECT rowid FROM layer2_conversations ORDER BY timestamp DESC LIMIT 500)")
    conn.commit()
    conn.close()

if __name__ == "__main__":
    resume()
